# Copy this file to `.env` and fill in real values for your machine.
# .env is git-ignored and should never be committed.
# This .env.example file IS committed, so it must never contain real secrets.

# --- Core Django settings ---
# Generate one with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- PostgreSQL ---
# Leave these unset/commented-out to automatically fall back to a local
# SQLite database file (db.sqlite3) for development.
# POSTGRES_DB=sigma_social
# POSTGRES_USER=sigma_social_user
# POSTGRES_PASSWORD=changeme
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# --- Alternative: a single connection string ---
# Some hosting platforms (Render, Railway) instead provide this, and it's
# also the recommended way to connect to Supabase PostgreSQL in production.
# If set, it takes priority.
# DATABASE_URL=postgres://user:password@host:5432/dbname

# --- Cloudinary (production media storage) ---
# Leave all three unset for local development -- profile pictures and
# post images will be stored on local disk under media/, exactly as
# before. In production (Render), set all three so uploads are stored
# in Cloudinary instead, since Render's filesystem is not persistent.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
